# ─────────────────────────────────────────────────────────────────────────────
# S3 buckets for MoC-mate
# ─────────────────────────────────────────────────────────────────────────────

locals {
  prefix     = "moc-mate-${var.environment}"
  account_id = data.aws_caller_identity.current.account_id
}

data "aws_caller_identity" "current" {}

# ── Lesson Media (video, images, PDFs uploaded by admin) ──────────────────────
resource "aws_s3_bucket" "lesson_media" {
  bucket        = "${local.prefix}-lesson-media-${local.account_id}"
  force_destroy = var.environment == "dev" ? true : false
}

resource "aws_s3_bucket_versioning" "lesson_media" {
  bucket = aws_s3_bucket.lesson_media.id
  versioning_configuration { status = "Enabled" }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "lesson_media" {
  bucket = aws_s3_bucket.lesson_media.id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

resource "aws_s3_bucket_public_access_block" "lesson_media" {
  bucket                  = aws_s3_bucket.lesson_media.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_cors_configuration" "lesson_media" {
  bucket = aws_s3_bucket.lesson_media.id

  cors_rule {
    allowed_headers = ["*"]
    allowed_methods = ["GET", "HEAD"]
    allowed_origins = ["*"]   # Tighten to your app domain in prod
    expose_headers  = ["ETag"]
    max_age_seconds = 3000
  }
}

resource "aws_s3_bucket_lifecycle_configuration" "lesson_media" {
  bucket = aws_s3_bucket.lesson_media.id

  rule {
    id     = "abort-incomplete-multipart"
    status = "Enabled"
    abort_incomplete_multipart_upload { days_after_initiation = 7 }
  }
}

# ── PDF Exports (generated by Lambda, user-downloadable) ─────────────────────
resource "aws_s3_bucket" "pdf_exports" {
  bucket        = "${local.prefix}-pdf-exports-${local.account_id}"
  force_destroy = var.environment == "dev" ? true : false
}

resource "aws_s3_bucket_server_side_encryption_configuration" "pdf_exports" {
  bucket = aws_s3_bucket.pdf_exports.id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

resource "aws_s3_bucket_public_access_block" "pdf_exports" {
  bucket                  = aws_s3_bucket.pdf_exports.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

# Auto-expire generated PDFs after 7 days (user downloads via pre-signed URL)
resource "aws_s3_bucket_lifecycle_configuration" "pdf_exports" {
  bucket = aws_s3_bucket.pdf_exports.id

  rule {
    id     = "expire-generated-pdfs"
    status = "Enabled"
    expiration { days = 7 }
    abort_incomplete_multipart_upload { days_after_initiation = 1 }
  }
}
